COMPARISION
///////////////////////////////////

let marks = 75
let passMark = 50

print(marks > passMark)
print(marks == 50)
print(marks != 75)
print(marks >= 75)
print(passMark < marks)

LOOPS
///////////////////////////////////

let number = [10,25,40,55]
for num in number{
    if num >= 30{
        print("\(num):Big")
    }
    else{
        print("\(num):Small")
    }
}
for i in 1..<4{
    print(i)
}

NIL-Coalescing Operator
/////////////////////////////////

var name: String? = "Gamer"
let nick = name ?? "Ashik"
print(nick)


PRECEDENCE and SHORT CIRCUIT
////////////////////////////////

print(5 + 2 * 3)
print((5 + 2) * 3)

let a = 10
print(a > 5 && a < 20)
print(a < 5 || a == 10)

let age = 17
print(age >= 18 && age <= 25)
